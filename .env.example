APP_NAME="سامانه مدیریت بارگیری واگن"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

# مسیر فایل دیتابیس: database/database.sqlite (با دستور php artisan migrate ساخته می‌شود)
DB_CONNECTION=sqlite
# DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_COOKIE=wagon_session
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_STACK=single

# این برنامه کاملاً آفلاین است، پس هیچ سرویس ایمیل/SMS/CDN خارجی استفاده نمی‌شود
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@wagon.local"
MAIL_FROM_NAME="${APP_NAME}"

# رمز اولیه کاربر ادمین در زمان seed؛ اگر خالی باشد یک رمز تصادفی ساخته و نمایش داده می‌شود
# بعداً با دستور php artisan admin:reset-password قابل تغییر است
SEED_ADMIN_EMAIL=admin@wagon.local
SEED_ADMIN_PASSWORD=
