APP_NAME="سامانه مدیریت بارگیری واگن"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

# ---------------------------------------------------------------------------
# دیتابیس: MySQL / MariaDB
# ---------------------------------------------------------------------------
# پیش از migrate، دیتابیس را یک بار بسازید:
#   CREATE DATABASE wagon_system CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# (فایل database/create_database.sql هم برای همین کار آماده است)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wagon_system
DB_USERNAME=root
DB_PASSWORD=
# اگر MySQL روی سوکت یونیکس اجرا می‌شود (مثلاً /var/run/mysqld/mysqld.sock):
# DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# اجرای امن کلیدهای خارجی (برای MySQL لازم نیست تغییر کند)
DB_FOREIGN_KEYS=true

# ---------------------------------------------------------------------------
# نشست و کوکی‌ها (امنیت)
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE=wagon_system_session
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
# روی HTTPS این را true بگذارید. اگر خط را حذف/خالی بگذارید، لاراول خودش
# بر اساس HTTPS بودن درخواست تصمیم می‌گیرد (پیشنهاد ما همین است).
# SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# پروکسی / CDN (اختیاری)
# ---------------------------------------------------------------------------
# اگر سایت پشت Cloudflare یا reverse proxy است، این را * بگذارید تا HTTPS و
# IP واقعی کاربر درست تشخیص داده شود. در غیر این صورت خالی بماند.
# TRUSTED_PROXIES=*

# ---------------------------------------------------------------------------
# ابزار عیب‌یابی diagnose.php
# ---------------------------------------------------------------------------
# صفحه diagnose.php اطلاعات فنی سرور را نشان می‌دهد و به‌صورت پیش‌فرض فقط از
# خود سرور (127.0.0.1) باز می‌شود. برای دسترسی از مرورگر خودتان یک رشته
# تصادفی طولانی اینجا بگذارید و صفحه را با ?key=همان-رشته باز کنید.
# بعد از رفع خطا، فایل diagnose.php را حذف کنید.
# DIAGNOSE_KEY=یک-رشته-تصادفی-طولانی

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_STACK=single

# این برنامه کاملاً آفلاین است، پس هیچ سرویس ایمیل/SMS/CDN خارجی استفاده نمی‌شود
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@wagon.local"
MAIL_FROM_NAME="${APP_NAME}"

# رمز اولیه کاربر ادمین در زمان seed؛ اگر خالی باشد یک رمز تصادفی ساخته و نمایش داده می‌شود
# بعداً با دستور php artisan admin:reset-password قابل تغییر است
SEED_ADMIN_EMAIL=admin@wagon.local
SEED_ADMIN_PASSWORD=
